# Template for .env — commit this file, NOT .env
#
# Usage:
#   cp .env.example .env
#   # then fill in the real credentials in .env
#
# Mirrors include/config/secrets.hpp: the ingest connects to the same broker as
# the firmware, with the same user, but a different client_id.

MQTT_BROKER=YOUR_HOST.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=YOUR_MQTT_USER
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_USE_TLS=true

# Must be unique on the broker — reusing the firmware's id disconnects the ESP32.
MQTT_CLIENT_ID=menta-ingest-01
